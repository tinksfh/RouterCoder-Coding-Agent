+def get_unpacked_marks(obj: object, *, consider_mro: bool = True) -> Iterable[Mark]:
+    """Obtain the unpacked marks that are stored on an object.
+
+    If the object is a class, include marks from its bases in reverse MRO order.
+    """
+    if inspect.isclass(obj):
+        for cls in reversed(obj.__mro__) if consider_mro else (obj,):
+            mark_list = cls.__dict__.get("pytestmark", [])
+            if not isinstance(mark_list, list):
+                mark_list = [mark_list]
+            yield from normalize_mark_list(mark_list)
+        return
