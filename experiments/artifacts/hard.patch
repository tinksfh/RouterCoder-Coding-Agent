+    def test_mark_multiple_inheritance(self, pytester: Pytester) -> None:
+        p = pytester.makepyfile(
+            """
+            import pytest
+
+            @pytest.mark.shared(source="base")
+            class Base: pass
+
+            @pytest.mark.foo
+            class Foo(Base): pass
+
+            @pytest.mark.bar
+            class Bar(Base): pass
+
+            @pytest.mark.shared(source="child")
+            class TestDings(Foo, Bar):
+                def test_dings(self): pass
+            """
+        )
+        items, _ = pytester.inline_genitems(p)
+        assert len(items) == 1
+        marks = list(items[0].iter_markers())
+        assert [mark.name for mark in marks] == ["shared", "bar", "foo", "shared"]
+        assert [mark.kwargs["source"] for mark in marks if mark.name == "shared"] == [
+            "base", "child"
+        ]
+
+    def test_mark_multiple_inheritance_without_child_mark(self, pytester: Pytester) -> None:
